{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.2 <23",
    "yarn": "1.x"
  },
  "scripts": {
    "dev": "vite",
    "test": "node --no-warnings ./node_modules/vitest/vitest.mjs run --silent=passed-only --reporter=dot",
    "test:watch": "node --no-warnings ./node_modules/vitest/vitest.mjs",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:ci": "eslint . --max-warnings 0",
    "format": "prettier -w .",
    "format:check": "prettier -c .",
    "verify": "yarn typecheck && yarn lint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@mantine/core": "^9.5.0",
    "@mantine/hooks": "^9.5.0",
    "@mantine/modals": "^9.5.0",
    "@mantine/notifications": "^9.5.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-virtual": "^3.13.18",
    "@xyflow/react": "^12.10.0",
    "effector": "^23.4.4",
    "effector-react": "^23.3.0",
    "elkjs": "^0.12.0",
    "i18next": "^26.3.6",
    "patronum": "^2.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.71.1",
    "react-i18next": "^17.0.11",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "unist-util-visit": "^5.0.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.4.23",
    "eslint": "^10.8.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.0.0",
    "postcss": "^8.5.6",
    "prettier": "^3.8.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.53.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
