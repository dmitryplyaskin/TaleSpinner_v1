{
  "name": "rp-llm",
  "version": "0.0.0",
  "description": "my pet",
  "main": "index.js",
  "author": "Dmitry Plyaskin",
  "license": "MIT",
  "engines": {
    "node": ">=22.22.2 <23",
    "yarn": "1.x"
  },
  "resolutions": {
    "**/@esbuild-kit/core-utils/esbuild": "^0.25.0"
  },
  "dependencies": {
    "argon2": "0.45.1",
    "axios": "^1.13.2",
    "better-sqlite3": "^13.0.2",
    "chromadb": "^3.3.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "express": "^5.2.1",
    "liquidjs": "^10.24.0",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "openai": "^7.1.0",
    "sharp": "^0.35.3",
    "zod": "^4.3.5"
  },
  "scripts": {
    "start": "node dist/server/src/index.js",
    "start:dev": "nodemon",
    "start:frontend": "cd ../web && yarn dev",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json -w",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --no-warnings ./node_modules/vitest/vitest.mjs run --silent=passed-only --reporter=dot",
    "test:watch": "node --no-warnings ./node_modules/vitest/vitest.mjs",
    "test:e2e:smoke": "node --no-warnings ./node_modules/vitest/vitest.mjs run --silent=passed-only --reporter=dot -c vitest.e2e.config.mts src/e2e/smoke/backend.smoke.e2e.spec.ts",
    "test:e2e:full": "node --no-warnings ./node_modules/vitest/vitest.mjs run --silent=passed-only --reporter=dot -c vitest.e2e.config.mts src/e2e/full-matrix.e2e.spec.ts src/e2e/full-matrix-extra.e2e.spec.ts",
    "test:e2e:stability": "node --no-warnings ./node_modules/vitest/vitest.mjs run --silent=passed-only --reporter=dot -c vitest.e2e.config.mts src/e2e/stability/smoke-repeat.e2e.spec.ts",
    "test:e2e:blackbox": "node --no-warnings ./node_modules/vitest/vitest.mjs run --silent=passed-only --reporter=dot -c vitest.e2e.config.mts src/e2e/smoke/blackbox.smoke.e2e.spec.ts",
    "seed:chat:large": "tsx src/scripts/seed-large-chat.ts",
    "seed:chat:extreme": "tsx src/scripts/seed-large-chat.ts --extreme",
    "lint": "eslint . --config eslint.config.mjs",
    "lint:fix": "eslint . --config eslint.config.mjs --fix",
    "lint:ci": "eslint . --config eslint.config.mjs --max-warnings=0",
    "verify": "yarn typecheck && yarn lint",
    "db:generate": "drizzle-kit generate",
    "db:generate:init": "drizzle-kit generate --name init",
    "db:migrate": "tsx ./src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "dev": "nodemon"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.31.8",
    "eslint": "^10.8.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.0.0",
    "nodemon": "^3.1.11",
    "peggy": "^5.1.0",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.53.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
